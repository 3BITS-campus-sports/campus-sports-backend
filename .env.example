# Copiaza acest fisier ca ".env" (cp .env.example .env) si schimba parola.
# ".env" NU se pune in Git (vezi .gitignore); ".env.example" DA.
DB_NAME=campus_sports
DB_USER=campus_admin
DB_PASSWORD=schimba_ma_cu_o_parola_lunga
DB_PORT=5432

# Folosit de backend (Sequelize / pg):
DATABASE_URL=postgres://campus_admin:schimba_ma_cu_o_parola_lunga@localhost:5432/campus_sports

# Secretul pentru tokenurile JWT (autentificare). Pune un sir lung si aleator, diferit de acesta.
JWT_SECRET=schimba_ma_cu_un_secret_lung_si_aleator
# Cat timp ramane valid tokenul dupa login (optional, implicit 8h)
JWT_EXPIRES_IN=8h
